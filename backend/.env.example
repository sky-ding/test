# 复制本文件为 backend/.env 后按需填写（pydantic-settings 会读取 PM_ 前缀变量）
# 团队多实例部署：所有实例必须使用相同的 PM_MYSQL_* 与 PM_SESSION_SECRET，并指向同一 MySQL 库。

# --- 生产/团队必填：会话（多实例必须一致）---
PM_SESSION_SECRET=change-me-to-a-long-random-string

# --- MySQL（同时设置 HOST + USER + DATABASE 即启用；否则回落本地 SQLite backend/data/app.db）---
# 库须预先创建，字符集建议 utf8mb4_unicode_ci / utf8mb4_0900_ai_ci
PM_MYSQL_HOST=127.0.0.1
PM_MYSQL_PORT=3306
PM_MYSQL_USER=root
PM_MYSQL_PASSWORD=change_me
PM_MYSQL_DATABASE=projectguard
PM_MYSQL_CHARSET=utf8mb4

# --- 可选：库到库同步 registry（scripts/sync_registry_to_api_db.py）---
# 与上面 PM_MYSQL_*（API 目标库）同时配置时，可从「导入所在库」拷 manpower/phase/risk 三行到目标库。
# PM_SOURCE_MYSQL_HOST=
# PM_SOURCE_MYSQL_PORT=3306
# PM_SOURCE_MYSQL_USER=
# PM_SOURCE_MYSQL_PASSWORD=
# PM_SOURCE_MYSQL_DATABASE=
# PM_SOURCE_MYSQL_CHARSET=utf8mb4

# --- 可选 ---
# PM_SKY_INITIAL_PASSWORD=
# PM_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# PM_AUTH_DISABLED=false
