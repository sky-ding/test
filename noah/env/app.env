# Environment configuration for ipd-pmo.vip.vip.com
# This file contains environment-specific settings

# Application settings
APP_NAME=ipd-pmo
DOMAIN=ipd-pmo.vip.vip.com

# Python settings
PYTHONPATH=/app

# Service settings
SERVICE_PORT=8001
SERVICE_HOST=0.0.0.0

# 应用入口（参考）：vmock-server.tools.vipshop.com / 10.190.28.127
# MySQL 存储集群：ipd-pmo — 连接请使用内网主机名（与 IP 二选一即可，优先主机名）
PM_MYSQL_HOST=mysql-standalone-ipd-pmo-0000.t18210.vpaas.org
PM_MYSQL_PORT=3306
# 以下三项请按平台分配的库名与账号填写，勿将含真实密码的文件提交到公开仓库
PM_MYSQL_USER=root
PM_MYSQL_DATABASE=ipd-pmo
# PM_MYSQL_CHARSET=utf8mb4
# PM_MYSQL_PASSWORD 由发布平台/机器环境变量注入，禁止提交真实密码